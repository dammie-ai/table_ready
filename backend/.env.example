# Copy this file to .env and fill in real values. Never commit .env itself.

# Database (matches docker-compose.yml by default)
DB_USER=tableready_admin
DB_HOST=localhost
DB_NAME=tableready_db
DB_PASSWORD=SuperSecurePassword123!
DB_PORT=5432

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Stripe (test-mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Server
PORT=8001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006
